TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_CHAT_ID=replace_with_private_group_or_channel_chat_id
# Optional (Windows Task Scheduler): full path to python.exe if "py" / "python" is not on PATH,
# e.g. C:\Users\you\miniconda3\envs\jokes\python.exe
# JOKE_PYTHON=
# Optional (daily project report, project_agent/):
# ANTHROPIC_API_KEY=        # Claude writes the analysis + plan; rule-based fallback without it
# GITHUB_TOKEN=             # read-only token so open PRs/issues of private repos show up
# REPORT_TELEGRAM_CHAT_ID=  # send the report to another chat than the jokes
# REPORT_PYTHON=            # python.exe for the report if different from JOKE_PYTHON
